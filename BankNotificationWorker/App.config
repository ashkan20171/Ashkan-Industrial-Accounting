<?xml version="1.0" encoding="utf-8"?>
<configuration><startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/></startup><connectionStrings><add name="AccountingDb" connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=AshkanIndustrialAccounting;Integrated Security=True;Connect Timeout=30" providerName="System.Data.SqlClient"/></connectionStrings><appSettings><add key="PollIntervalSeconds" value="15"/><add key="BatchSize" value="25"/></appSettings></configuration>
