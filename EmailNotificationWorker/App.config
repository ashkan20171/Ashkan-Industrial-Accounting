<?xml version="1.0" encoding="utf-8"?>
<configuration>
 <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/></startup>
 <connectionStrings><add name="AccountingDb" connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=AshkanIndustrialAccounting;Integrated Security=True;Connect Timeout=30" providerName="System.Data.SqlClient"/></connectionStrings>
 <appSettings>
  <add key="PollIntervalSeconds" value="20"/><add key="BatchSize" value="10"/><add key="MaxAttempts" value="8"/>
  <add key="SmtpHost" value=""/><add key="SmtpPort" value="587"/><add key="SmtpFrom" value=""/>
  <add key="SmtpUser" value=""/><add key="SmtpPassword" value=""/><add key="SmtpEnableSsl" value="true"/>
 </appSettings>
</configuration>
